# Supabase (proyecto destino)
EXPO_PUBLIC_SUPABASE_URL=https://tegxlqniumczkzakjzgr.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# OAuth manual en Supabase Dashboard > Authentication > Providers
# 1) Site URL: rooalarm://auth/callback (o tu URL web si aplica)
# 2) Redirect URLs:
#    - rooalarm://auth/callback
#    - https://tegxlqniumczkzakjzgr.supabase.co/auth/v1/callback
# 3) Google: activar provider y pegar Client ID/Secret
# 4) Apple (Sign in with Apple nativo en iOS — signInWithIdToken):
#    Dashboard → Authentication → Providers → Apple → Enable
#    Client IDs (obligatorio): com.roo.alarm
#    Si también usas login web por navegador, añade: com.roo.alarm,com.roo.alarm.service
#    Para SOLO app nativa iOS NO hace falta Secret Key ni Services ID.
#    Secret Key (solo flujo web/OAuth): node scripts/generate-apple-oauth-secret.mjs ~/Downloads/AuthKey_XXXX.p8

# RevenueCat (Public SDK keys — seguras en cliente)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_key
# Solo para Expo Go / simulador sin build nativa (Test Store en RevenueCat)
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_your_test_store_key
# Product IDs App Store Connect (deben coincidir en RevenueCat):
# rooalarm_annual, rooalarm_weekly — entitlement: premium

# Gemini — validación de misiones con foto (ruleta / cámara)
# Clave desde Google Cloud Console (Generative Language API habilitada):
# https://console.cloud.google.com → APIs y servicios → Credenciales → Clave de API
# Pon la key real en .env.local
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash-lite
