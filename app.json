{
  "expo": {
    "name": "RooAlarm",
    "slug": "rooalarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "rooalarm",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roo.alarm",
      "buildNumber": "1",
      "appleTeamId": "YW6HVLQ9JV",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "RooAlarm usa la cámara solo para validar misiones de despertar, como hacer una foto del cielo o de un objeto elegido.",
        "NSAlarmKitUsageDescription": "RooAlarm usa alarmas del sistema para despertarte a la hora exacta y ejecutar tu misión."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-audio",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "RooAlarm usa la cámara solo para validar misiones de despertar."
        }
      ],
      "expo-notifications",
      "expo-asset",
      "./plugins/withAlarmKit.js",
      "./plugins/withStoreKit.js"
    ],
    "extra": {
      "eas": {
        "projectId": "b0b7b20a-9a9c-4c17-a91f-25e752649a85"
      }
    },
    "owner": "oneliveapp"
  }
}
